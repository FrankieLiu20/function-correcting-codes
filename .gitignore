# Lean / Lake build artifacts — NEVER commit these
.lake/
build/
*.olean
*.ilean
*.c
.DS_Store

# Editor scratch files
FCC/* [0-9].lean
scripts/* [0-9].sh

# Local-only reference material
#   reference/  : a local clone of a reference repository (e.g. the teacher's)
#   *.pdf       : the papers themselves (IEEE/arXiv copyright: keep local)
reference/
*.pdf

